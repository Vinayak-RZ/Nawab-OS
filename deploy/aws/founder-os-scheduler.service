[Unit]
Description=Founder OS background scheduler (heartbeats, backups, reminders)
After=network-online.target founder-os.service
Wants=network-online.target

[Service]
Type=simple
User=founder
Group=founder
WorkingDirectory=/opt/founder-os
EnvironmentFile=/etc/founder-os/env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/founder-os/.venv/bin/python -m scheduler.standalone
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
